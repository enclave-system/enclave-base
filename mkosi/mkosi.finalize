#!/bin/bash
# Last step before the disk image is assembled ($BUILDROOT = image root):
#  1. remove the package manager, interpreters and compilers
#  2. move unit enablement/masks from /etc/systemd/system into /usr (the root
#     file system is a tmpfs, so /etc starts empty and is populated only after
#     PID 1 has loaded its units)
#  3. snapshot /etc into /usr/share/factory/etc (enklave-etc.service)
#  4. sanity checks; any failure aborts the build
set -euo pipefail
shopt -s nullglob
root="${BUILDROOT:?}"
die() { echo "mkosi.finalize: $*" >&2; exit 1; }

# 1. package manager, interpreters, compilers
rm -f "$root"/usr/bin/{apt,apt-get,apt-cache,apt-mark,apt-config,apt-cdrom,apt-key} \
      "$root"/usr/bin/{apt-extracttemplates,apt-ftparchive,apt-sortpkgs} \
      "$root"/usr/bin/dpkg "$root"/usr/bin/dpkg-* "$root"/usr/sbin/dpkg-*
rm -rf "$root"/usr/lib/apt "$root"/usr/lib/dpkg "$root"/var/lib/dpkg "$root"/var/lib/apt \
       "$root"/var/cache/apt "$root"/etc/apt "$root"/etc/dpkg
rm -f "$root"/usr/bin/perl* "$root"/usr/bin/python3*
rm -f "$root"/usr/bin/gcc* "$root"/usr/bin/g++* "$root"/usr/bin/cc "$root"/usr/bin/c++ \
      "$root"/usr/bin/x86_64-linux-gnu-gcc* "$root"/usr/bin/x86_64-linux-gnu-g++*

[ -e "$root/usr/bin/sh" ] || die "/usr/bin/sh is missing (needed by Debian scripts)"
for p in usr/bin/apt usr/bin/apt-get usr/bin/dpkg var/lib/dpkg usr/bin/perl usr/bin/python3 usr/bin/gcc usr/bin/cc; do
    [ ! -e "$root/$p" ] && [ ! -L "$root/$p" ] || die "/$p still present"
done

# 2. /etc/systemd/system -> /usr/lib/systemd/system
src="$root/etc/systemd/system"
dst="$root/usr/lib/systemd/system"
if [ -d "$src" ]; then
    for e in "$src"/*; do
        n="${e##*/}"
        if [ -L "$e" ]; then
            t="$(readlink "$e")"
            rm -rf "${dst:?}/$n"
            if [ "$t" = /dev/null ]; then
                ln -s /dev/null "$dst/$n"            # mask
            else
                ln -s "${t##*/}" "$dst/$n"           # alias
            fi
        elif [ -d "$e" ]; then
            case "$n" in
                *.wants|*.requires|*.upholds)
                    mkdir -p "$dst/$n"
                    for l in "$e"/*; do
                        [ -L "$l" ] || die "unexpected non-symlink $l"
                        t="$(readlink "$l")"
                        ln -sfn "../${t##*/}" "$dst/$n/${l##*/}"
                    done ;;
                *.d)
                    mkdir -p "$dst/$n"
                    cp -a "$e/." "$dst/$n/" ;;
                *) die "unexpected directory $e" ;;
            esac
        else
            cp -a "$e" "$dst/$n"                     # full unit override
        fi
    done
    rm -rf "${src:?}"
    mkdir -p "$src"
fi

# 2b. no login stack: drop the static wants links shipped by systemd
#     (getty@tty1, getty.target, systemd-logind, systemd-user-sessions).
#     Nothing in the image needs logind (no sessions, no seats).
rm -f "$dst"/*.wants/getty* "$dst"/*.wants/systemd-logind.service \
      "$dst"/*.wants/systemd-user-sessions.service

# 2c. ESP: only systemd-boot and the signed UKIs. The kernel package's
#     unsigned vmlinuz, System.map and config are not needed (the UKI carries
#     the kernel); loader.conf hardens systemd-boot.
rm -f "$root"/boot/vmlinuz* "$root"/boot/System.map* "$root"/boot/config* "$root"/boot/initrd*
loader_conf=(
    "timeout 0"
    "editor no"
    "auto-entries no"
    "auto-firmware no"
    "secure-boot-enroll off"
)
# Both /boot and /efi are copied into the ESP (00-esp.conf); bootctl puts
# its default loader.conf under /efi, so write ours to both.
for d in boot efi; do
    mkdir -p "$root/$d/loader"
    printf '%s\n' "${loader_conf[@]}" > "$root/$d/loader/loader.conf"
done

# 3. /etc snapshot (machine-id is generated per boot by PID 1)
fac="$root/usr/share/factory/etc"
mkdir -p "$fac"
cp -a "$root/etc/." "$fac/"
rm -f "$fac/machine-id"

# 4. sanity checks
pw="$(awk -F: '$1 == "root" { print $2 }' "$fac/shadow")"
case "$pw" in
    '!'*|'*'*) ;;
    *) die "root password is not locked" ;;
esac
for u in getty@.service serial-getty@.service console-getty.service autovt@.service \
         container-getty@.service getty.target debug-shell.service systemd-firstboot.service \
         emergency.service rescue.service emergency.target rescue.target; do
    [ "$(readlink "$dst/$u")" = /dev/null ] || die "$u is not masked in /usr"
done
for l in "$dst"/*.wants/getty* "$dst"/*.wants/systemd-logind.service \
         "$dst"/*.wants/systemd-user-sessions.service; do
    die "login-related wants link left in /usr: ${l#"$root"}"
done
# unit_value FILE SECTION KEY: last value of KEY in [SECTION] (systemd semantics:
# the last assignment wins, an empty assignment resets).
# Keys and section headers may carry surrounding whitespace ("  Key = v").
unit_value() {
    awk -v sec="[$2]" -v key="$3" '
        { line = $0; gsub(/^[[:space:]]+|[[:space:]]+$/, "", line) }
        line ~ /^\[/ { in_sec = (line == sec); next }
        in_sec {
            k = line; sub(/[[:space:]]*=.*$/, "", k)
            if (k == key && index(line, "=") > 0) { v = line; sub(/^[^=]*=[[:space:]]*/, "", v) }
        }
        END { print v }' "$1"
}
# key_count FILE KEY [SECTION]: occurrences of KEY (in SECTION, or anywhere).
key_count() {
    awk -v key="$2" -v sec="${3:+[$3]}" '
        { line = $0; gsub(/^[[:space:]]+|[[:space:]]+$/, "", line) }
        line ~ /^\[/ { s = line; next }
        { k = line; sub(/[[:space:]]*=.*$/, "", k) }
        k == key && index(line, "=") > 0 && (sec == "" || s == sec) { c++ }
        END { print c + 0 }' "$1"
}
# Drop-in directories systemd applies to a unit: type-level (service.d),
# dash-prefix levels (enklave-.service.d, enklave-var-.service.d, ...) and
# the unit's own. A FailureAction in a shared directory would be ambiguous.
shared_dropin_dirs() {
    local u="$1" type="${1##*.}" base="${1%.*}" pfx=""
    echo "$dst/$type.d"
    while [ "${base#*-}" != "$base" ]; do
        pfx="$pfx${base%%-*}-"; base="${base#*-}"
        echo "$dst/$pfx.$type.d"
    done
}
for u in enklave-var-repart.service enklave-var-unlock.service enklave-var-auth.service var-lib-enklave.mount enklave-state.service \
         enklave-require-secureboot.service systemd-pcrphase-sysinit.service enklave-pcr11-sealed.service; do
    [ -f "$dst/$u" ] || die "$u missing"
    for d in $(shared_dropin_dirs "$u"); do
        for f in "$d"/*.conf; do
            [ -f "$f" ] || continue
            [ "$(key_count "$f" FailureAction)" = 0 ] || die "${f#"$root"}: FailureAction in a shared drop-in directory"
        done
    done
    v=""
    for f in "$dst/$u" "$dst/$u.d"/*.conf; do
        [ -f "$f" ] || continue
        [ "$(key_count "$f" FailureAction)" = "$(key_count "$f" FailureAction Unit)" ] \
            || die "${f#"$root"}: FailureAction= outside [Unit] (ignored by systemd)"
        [ "$(key_count "$f" FailureAction Unit)" = 0 ] || v="$(unit_value "$f" Unit FailureAction)"
    done
    want=poweroff-force
    [ ! -e "$root/usr/lib/enklave/test-profile" ] || want=none   # test profile: log only
    [ "$v" = "$want" ] || die "$u: effective [Unit] FailureAction is '$v', want $want"
done
grep -qx 'TimeoutSec=600' "$dst/enklave-var-unlock.service" || die "enklave-var-unlock needs a finite timeout"
[ -s "$root/usr/lib/enklave/release.json" ] || die "release.json missing"
grep -Eq '"dev_keys":(true|false)' "$root/usr/lib/enklave/release.json" || die "release.json lacks the dev_keys marker"
grep -Eq '"require_ftpm":(true|false)' "$root/usr/lib/enklave/release.json" || die "release.json lacks require_ftpm"
# B1: no image carries an EK allowlist. A TPM without EK certificate is
# admitted per device by a signed policy on the ESP, never by the image.
[ ! -e "$root/usr/lib/enklave/ek-allowlist" ] || die "EK allowlist in the image (admissions are per device, on the ESP)"
# B8: the state service is the only writer; its writers are JSON definitions.
[ -L "$dst/local-fs.target.requires/enklave-state.service" ] || die "enklave-state.service is not required by local-fs.target"
for f in "$root"/usr/lib/enklave/state-writers.d/*; do
    case "${f##*/}" in *.json) ;; *) die "unexpected file in state-writers.d: ${f##*/}" ;; esac
    grep -q '"unit"' "$f" || die "${f##*/}: a state writer names its unit"
    grep -q '"exec"' "$f" || die "${f##*/}: a state writer names its command"
done
grep -qx 'kernel.yama.ptrace_scope = 3' "$root/usr/lib/sysctl.d/50-enklave-ptrace.conf" || die "ptrace is not disabled (state keys live in the state service)"
# The state volume is mounted read-only (state-exec writes in a private namespace).
case ",$(unit_value "$dst/var-lib-enklave.mount" Mount Options)," in
    *,ro,*) ;;
    *) die "var-lib-enklave.mount must be mounted read-only" ;;
esac
# TPM vendor EK CA bundle: present, with provenance, without the Microsoft
# (virtual TPM) CAs. The CA of the emulated test TPMs exists in test-profile
# images only and test-profile images are always dev-signed.
ekca="$root/usr/share/enklave/tpm-ek-ca"
[ -s "$ekca/SOURCE" ] && [ -s "$ekca/SHA256SUMS" ] || die "TPM vendor CA bundle or its provenance missing"
[ "$(find "$ekca" -path '*/RootCA/*' -type f | wc -l)" -ge 40 ] || die "TPM vendor CA bundle incomplete"
[ ! -e "$ekca/Microsoft" ] || die "the Microsoft (virtual TPM) CAs must not be shipped"
( cd "$ekca" && sha256sum --quiet -c SHA256SUMS ) || die "TPM vendor CA bundle does not match SHA256SUMS"
[ "$(find "$ekca" -type f ! -name SOURCE ! -name SHA256SUMS | wc -l)" = "$(wc -l < "$ekca/SHA256SUMS")" ] \
    || die "TPM vendor CA bundle holds files that are not in SHA256SUMS"
if [ -e "$root/usr/lib/enklave/test-profile" ]; then
    [ -n "$(ls -A "$root/usr/share/enklave/tpm-ek-ca-test/RootCA" 2>/dev/null)" ] || die "test profile without the test TPM CA"
    grep -q '"dev_keys":true' "$root/usr/lib/enklave/release.json" || die "test-profile image without the dev-key marker"
else
    [ ! -e "$root/usr/share/enklave/tpm-ek-ca-test" ] || die "test TPM CA in a production image"
fi
# Signed Secure Boot variable updates: only dbx/db/KEK appends.
for f in "$root"/usr/lib/enklave/efi-updates/*; do
    case "${f##*/}" in
        dbx-*.auth|db-*.auth|KEK-*.auth) ;;
        *) die "unexpected file in efi-updates: ${f##*/}" ;;
    esac
done
grep -q -- '--factory-reset=no' "$dst/enklave-var-repart.service" || die "repart may honour factory reset"
r="$root/usr/lib/enklave/repart.d/30-var.conf"
[ "$(unit_value "$r" Partition FactoryReset)" = no ] || die "30-var.conf: FactoryReset must be no"
[ -z "$(unit_value "$r" Partition Encrypt)" ] || die "30-var.conf: Encrypt= must not be used (varauth formats /var)"
[ ! -e "$root/usr/lib/enklave/enklave-sign-policy" ] || die "build-time signer must not be shipped"
[ -z "$(ls -A "$root/boot" | grep -E '^(vmlinuz|System\.map|config|initrd)')" ] || die "kernel files left in /boot (ESP)"
for d in boot efi; do
    cmp -s "$root/$d/loader/loader.conf" <(printf '%s\n' "${loader_conf[@]}") \
        || die "/$d/loader/loader.conf not enforced"
done
[ -z "$(ls -A "$root/efi" | grep -E '^(vmlinuz|System\.map|config|initrd)')" ] || die "kernel files left in /efi (ESP)"
role="$(cat "$root/usr/lib/enklave/role" 2>/dev/null || true)"
case "$role" in
    ref|client|gateway|terminal|console|sluice|backup|fileserver) ;;
    *) die "/usr/lib/enklave/role missing or invalid: '$role'" ;;
esac
[ "$(stat -c %s "$root/usr/share/enklave/keys/config-signing.pub")" = 32 ] \
    || die "config-signing.pub missing or not 32 bytes"
for b in enklave-cfg enklave-selftest enklave-varauth var-unlock; do
    [ -x "$root/usr/lib/enklave/$b" ] || die "/usr/lib/enklave/$b missing"
done
[ "$(readlink "$root/usr/lib/enklave/require-secureboot")" = enklave-selftest ] \
    || die "require-secureboot symlink missing"
[ -d "$root/usr/lib/enklave/nft.d" ] || die "/usr/lib/enklave/nft.d missing"
