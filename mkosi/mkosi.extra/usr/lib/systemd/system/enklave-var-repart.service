# First boot: create the /var partition on the disk that carries /usr
# (LUKS2, bound to TPM2 PCR 7 and to the PCR 11 policy signed with the
# key embedded in the UKI). Later boots: no-op.
[Unit]
Description=Create TPM2-bound encrypted /var partition
DefaultDependencies=no
ConditionVirtualization=!container
# Never seal /var to a boot without Secure Boot.
Requires=enklave-require-secureboot.service
After=enklave-require-secureboot.service
Wants=tpm2.target
After=tpm2.target systemd-tpm2-setup-early.service systemd-udevd-kernel.socket
Before=enklave-var-unlock.service shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/systemd-repart --dry-run=no --definitions=/usr/lib/enklave/repart.d \
          --tpm2-device=auto --tpm2-pcrs=7 \
          --tpm2-public-key=/run/systemd/tpm2-pcr-public-key.pem --tpm2-public-key-pcrs=11
