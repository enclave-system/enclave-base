# First boot: create the (empty) /var partition on the disk that carries /usr.
# enclave-varauth refuses to run with a tainted PCR 12 and records whether the
# partition was created in this boot (/run/enclave/var-created); only then
# may /var and its TPM NV indices be provisioned. Later boots: no-op.
# Factory reset is never honoured here.
[Unit]
Description=Create the /var partition
DefaultDependencies=no
ConditionVirtualization=!container
# Never provision /var on a boot without Secure Boot.
Requires=enclave-require-secureboot.service
After=enclave-require-secureboot.service
Wants=tpm2.target
After=tpm2.target systemd-tpm2-setup-early.service systemd-udevd-kernel.socket
Before=enclave-var-unlock.service shutdown.target
Conflicts=shutdown.target
FailureAction=poweroff-force

[Service]
Type=oneshot
RemainAfterExit=yes
StandardError=journal+console
ExecStart=/usr/lib/enclave/enclave-varauth repart --dry-run=no --factory-reset=no \
          --definitions=/usr/lib/enclave/repart.d
