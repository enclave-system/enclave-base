# The state service: the only writer of the state volume and the only holder
# of the state keys at runtime (enclave-varauth state-serve).
#  - It takes the derived state keys out of /run/enclave/state.key and deletes
#    the file before it reports READY. local-fs.target requires it, so no
#    ordinary service starts while the file exists.
#  - PrivateMounts: the volume becomes writable only inside this unit's mount
#    namespace, for the duration of one commit.
#  - A commit runs a writer defined in /usr/lib/enclave/state-writers.d
#    (verity), for a caller in the cgroup /system.slice/<unit> that the
#    writer is reserved for (SO_PEERCRED, SO_PEERPIDFD, full cgroup path).
#  - A writer consumes either no caller input, or a bundle that the service
#    has verified: config-signing signature, this role, version higher than
#    the last accepted one. Root can enter the cgroup and trigger a writer;
#    it cannot make the service accept other content.
#  - The process is not dumpable and leaves no core (the keys are in it).
#  - Reads are authenticated against the manifest and the TPM counter.
# Production: a failure powers the machine off.
[Unit]
Description=enclave state service (authorized commits, verified reads)
DefaultDependencies=no
Requires=var-lib-enclave.mount
After=var-lib-enclave.mount enclave-var-auth.service
Before=local-fs.target shutdown.target
Conflicts=shutdown.target
FailureAction=poweroff-force

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/lib/enclave/enclave-varauth state-serve
PrivateMounts=yes
LimitCORE=0
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
StandardError=journal+console

[Install]
RequiredBy=local-fs.target
