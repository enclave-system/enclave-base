# The only persistent storage: the encrypted, integrity-protected and
# TPM-authenticated state volume. Everything else (/var itself, journal,
# caches) lives on the tmpfs root and is volatile. Data below data/ is
# written only through "enklave-varauth state-exec" (authenticated manifest
# bound to the TPM counter).
[Unit]
Description=Encrypted persistent enklave state
DefaultDependencies=no
Requires=enklave-var-unlock.service enklave-var-auth.service
After=enklave-var-unlock.service enklave-var-auth.service local-fs-pre.target
Before=local-fs.target umount.target
Conflicts=umount.target
FailureAction=poweroff-force

[Mount]
What=/dev/mapper/var
Where=/var/lib/enklave
Type=ext4
Options=nosuid,nodev,noexec

[Install]
RequiredBy=local-fs.target
