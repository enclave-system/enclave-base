# enklave: explicit allow-list. The first matching line wins across all
# preset files (sorted by name), so this file overrides 90-systemd.preset.
# Profiles and component repos put their own enable lines in a file sorting
# before this one (e.g. 05-enklave-test.preset).
enable enklave-etc.service
enable enklave-require-secureboot.service
enable var.mount
enable nftables.service
enable apparmor.service
disable *
