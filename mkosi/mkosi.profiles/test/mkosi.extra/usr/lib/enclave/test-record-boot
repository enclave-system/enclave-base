#!/bin/sh
# Test profile only: record this boot in the authenticated state store
# through the state service (writer "test-record", reserved for
# enclave-test-marker.service). ESP:/EFI/enclave/test-pause-state may name a
# commit phase at which the service pauses (crash-consistency proofs).
set -eu
pause=""
esp=/run/enclave-test-esp
mkdir -p "$esp"
if mount -t vfat -o nosuid,nodev,noexec /dev/disk/by-partlabel/esp "$esp" 2>/dev/null; then
    pause="$(cat "$esp/EFI/enclave/test-pause-state" 2>/dev/null || true)"
    umount "$esp"
fi
export ENCLAVE_STATE_PAUSE="$pause"
/usr/lib/enclave/enclave-varauth state-exec test-record < /dev/null
echo "enclave-test-marker: present" > /dev/ttyS0
