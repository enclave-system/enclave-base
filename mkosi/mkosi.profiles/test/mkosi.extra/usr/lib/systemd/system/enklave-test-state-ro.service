# Test profile only: direct writes to the state volume by root must be
# refused (read-only mount, M3). Runs before the marker unit, which writes
# through "enklave-varauth state-exec" and must still succeed.
[Unit]
Description=Probe: direct writes to the state volume must be refused (test profile)
After=enklave-selftest.service
Before=enklave-test-marker.service
RequiresMountsFor=/var/lib/enklave

[Service]
Type=oneshot
ExecStart=/usr/lib/enklave/test-state-ro

[Install]
WantedBy=graphical.target
