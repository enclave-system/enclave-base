# Test profile only: after boot, try to unseal the /var key again with the
# TPM2 token (as root, from the running system, through libcryptsetup's
# systemd-tpm2 token plugin). The signed PCR 11 policy only covers
# enter-initrd:leave-initrd, so this must be refused.
[Unit]
Description=Probe: /var key must not be unsealable after boot (test profile)
After=enklave-selftest.service
Before=enklave-test-marker.service
RequiresMountsFor=/var

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'dm=$(basename "$(readlink -f /dev/mapper/var)"); dev=/dev/$(ls /sys/block/$dm/slaves); if out=$(cryptsetup -v open --test-passphrase --token-only --token-type systemd-tpm2 "$dev" 2>&1); then echo "enklave-test-unseal-probe: $dev UNSEALED after boot (BAD)"; else echo "enklave-test-unseal-probe: $dev refused after boot (ok): $(echo "$out" | tr "\n" " ")"; fi > /dev/ttyS0'

[Install]
WantedBy=graphical.target
