# Creates /var/lib/enklave/marker AFTER the selftest ran, so the first boot
# reports marker=false and every later boot (same TPM) marker=true.
[Unit]
Description=Create /var/lib/enklave/marker (test profile)
After=enklave-selftest.service
RequiresMountsFor=/var/lib/enklave

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'mkdir -p /var/lib/enklave && { [ -e /var/lib/enklave/marker ] || : > /var/lib/enklave/marker; } && sync && echo "enklave-test-marker: present" > /dev/ttyS0'

[Install]
# Not multi-user.target: a target is ordered after the units it wants, which
# would form a cycle with After=multi-user.target. default.target = graphical.target.
WantedBy=graphical.target
