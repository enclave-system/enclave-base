# Test profile only: print PCR 0, 2, 4, 7, 11 and 12 to the serial console before /var
# is unlocked (evidence for the PCR 7+12 binding of /var).
[Unit]
Description=Print TPM PCRs 0/2/4/7/11/12 (test profile)
DefaultDependencies=no
Wants=tpm2.target
After=tpm2.target systemd-tpm2-setup-early.service
Before=enklave-var-unlock.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'tpm2_pcrread sha256:0,2,4,7,11,12 | sed "s/^/enklave-test-pcrs: /" > /dev/ttyS0'

[Install]
WantedBy=sysinit.target
