# Test profile additions; sorts before 10-enklave.preset ("disable *").
enable enklave-selftest.service
enable enklave-test-marker.service
enable enklave-test-pcrs.service
enable enklave-test-unseal-probe.service
enable enklave-test-state-ro.service
enable enklave-test-state-auth.service
enable systemd-networkd.service
enable systemd-networkd.socket
