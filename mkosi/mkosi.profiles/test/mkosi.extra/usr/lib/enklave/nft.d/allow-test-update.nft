# Test profile only: DHCP and the VM test update source 10.0.2.2:8080.
# Replies to the TCP connection pass via "ct state established,related".
table ip enklave {
	chain input {
		udp sport 67 udp dport 68 accept
	}

	chain output {
		udp sport 68 udp dport 67 accept
		ip daddr 10.0.2.2 tcp dport 8080 accept
	}
}
