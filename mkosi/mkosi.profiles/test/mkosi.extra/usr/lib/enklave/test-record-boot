#!/bin/sh
# Test profile only: record this boot in the authenticated state store
# through enklave-varauth state-exec. ESP:/EFI/enklave/test-pause-state may
# name a commit phase at which state-exec pauses (crash-consistency proofs).
set -eu
pause=""
esp=/run/enklave-test-esp
mkdir -p "$esp"
if mount -t vfat -o nosuid,nodev,noexec /dev/disk/by-partlabel/esp "$esp" 2>/dev/null; then
    pause="$(cat "$esp/EFI/enklave/test-pause-state" 2>/dev/null || true)"
    umount "$esp"
fi
export ENKLAVE_STATE_PAUSE="$pause"
/usr/lib/enklave/enklave-varauth state-exec -- /bin/sh -c '
    [ -e "$ENKLAVE_STATE_DIR/marker" ] || : > "$ENKLAVE_STATE_DIR/marker"
    head -c 6000 /dev/urandom | od -An -tx1 >> "$ENKLAVE_STATE_DIR/bootlog"'
echo "enklave-test-marker: present" > /dev/ttyS0
