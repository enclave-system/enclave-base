# Client flavor: WLAN, graphics, laptop HID, VM GPU drivers.
CONFIG_NETDEVICES=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=m
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_IWLDVM=n
CONFIG_RFKILL=y

CONFIG_DRM=y
CONFIG_DRM_I915=m
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMDGPU_SI=n
CONFIG_DRM_AMDGPU_CIK=n
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_HYPERV=m
CONFIG_DRM_VIRTIO_GPU=m
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_SYSFB_SIMPLEFB=y

CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_I2C=y
CONFIG_I2C_HID_ACPI=y
CONFIG_HID_MULTITOUCH=y
CONFIG_HID_LENOVO=y
CONFIG_HID_APPLE=n
CONFIG_HID_SENSOR_HUB=n
CONFIG_THINKPAD_ACPI=y
