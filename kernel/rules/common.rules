# Rules for both flavors. CONFIG_X=v must hold; !CONFIG_X must be unset.
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_CONFIDENTIALITY=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA512=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_DM_VERITY=y
CONFIG_DM_VERITY_VERIFY_ROOTHASH_SIG=y
CONFIG_DM_CRYPT=y
CONFIG_TCG_TPM=y
CONFIG_TCG_CRB=y
CONFIG_TCG_TIS=y
CONFIG_EFI_STUB=y
CONFIG_NF_TABLES=y
CONFIG_WIREGUARD=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_INTEL_IOMMU=y
CONFIG_AMD_IOMMU=y
# CPU vulnerability mitigations (renamed from RETPOLINE/PAGE_TABLE_ISOLATION in 6.9; pti=on needs the latter)
CONFIG_CPU_MITIGATIONS=y
CONFIG_MITIGATION_RETPOLINE=y
CONFIG_MITIGATION_RETHUNK=y
CONFIG_MITIGATION_IBRS_ENTRY=y
CONFIG_MITIGATION_PAGE_TABLE_ISOLATION=y

# Memory/stack hardening pinned so a silent drop fails the build
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_RANDOM_KMALLOC_CACHES=y
CONFIG_VMAP_STACK=y
CONFIG_ZERO_CALL_USED_REGS=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_INTEL_IOMMU_DEFAULT_ON=y
CONFIG_IOMMU_DEFAULT_DMA_STRICT=y
CONFIG_SECURITY_YAMA=y
CONFIG_LEGACY_VSYSCALL_NONE=y
# AppArmor/lockdown chain on the cmdline depends on this exact order
CONFIG_LSM="lockdown,yama,integrity,apparmor,bpf"

# Ruling R3: JIT always on is Spectre hardening; unprivileged BPF off.
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y

!CONFIG_USB_STORAGE
!CONFIG_USB_UAS
!CONFIG_BT
!CONFIG_FIREWIRE
!CONFIG_THUNDERBOLT
!CONFIG_USB4
!CONFIG_IPV6
!CONFIG_DEVMEM
!CONFIG_DEVPORT
!CONFIG_KEXEC
!CONFIG_KEXEC_FILE
!CONFIG_HIBERNATION
!CONFIG_DEBUG_FS
!CONFIG_SOUND
!CONFIG_MEDIA_SUPPORT
!CONFIG_LEGACY_VSYSCALL_EMULATE
!CONFIG_PROC_KCORE
