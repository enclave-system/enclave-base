# Server flavor: no WLAN, no GPU drivers (ruling R2: simpledrm framebuffer stays).
!CONFIG_CFG80211
!CONFIG_WLAN
CONFIG_DRM_SIMPLEDRM=y
!CONFIG_DRM_I915
!CONFIG_DRM_AMDGPU
!CONFIG_DRM_NOUVEAU
!CONFIG_DRM_RADEON
# VM drivers (no GPU)
CONFIG_HYPERV=y
CONFIG_HYPERV_NET=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
CONFIG_VMWARE_PVSCSI=y
CONFIG_VMXNET3=y
