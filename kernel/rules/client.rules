# Client flavor: WLAN, graphics, HID (Lenovo ThinkPads / PCs) and VM drivers.
CONFIG_IWLWIFI=m
CONFIG_CFG80211=y
CONFIG_DRM_I915=m
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_SIMPLEDRM=y
CONFIG_HYPERV=y
CONFIG_HYPERV_NET=y
CONFIG_DRM_HYPERV=m
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
CONFIG_DRM_VIRTIO_GPU=m
CONFIG_VMWARE_PVSCSI=y
CONFIG_VMXNET3=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
